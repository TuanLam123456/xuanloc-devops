# Biến cho docker-compose.yml - copy thành file .env (cùng thư mục) rồi đổi mật khẩu.
# Mật khẩu chỉ dùng chữ và số vì nó được ghép vào DATABASE_URL.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=xuan_loc_center
MYSQL_USER=xuanloc
MYSQL_PASSWORD=change-me-app
# User chỉ-đọc cho mysqld-exporter (monitoring)
MYSQL_EXPORTER_PASSWORD=change-me-exporter
