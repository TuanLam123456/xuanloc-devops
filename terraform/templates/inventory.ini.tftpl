# File này do Terraform sinh ra (terraform/inventory.tf) - không sửa tay, chạy lại terraform apply để cập nhật

[app]
xuanloc-app ansible_host=${app_public_ip} private_ip=${app_private_ip}

[monitoring]
xuanloc-monitoring ansible_host=${monitoring_public_ip} private_ip=${monitoring_private_ip}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_private_key_path}
ansible_python_interpreter=/usr/bin/python3
