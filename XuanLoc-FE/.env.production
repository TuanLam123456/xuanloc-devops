# File này được commit: mọi biến VITE_* đều công khai trong bundle JS, không đặt secret ở đây.
# Vite tự đọc file này khi chạy `vite build`. Docker build có thể ghi đè VITE_API_URL bằng build ARG.

# Server & API Base URL
VITE_API_URL=https://api-xuanloc.bui-van-tuan-lam.com/api

# 1. Auth Endpoints
VITE_EP_AUTH_LOGIN=/auth/login
VITE_EP_AUTH_LOGOUT=/auth/logout
VITE_EP_AUTH_REFRESH_TOKEN=/auth/refresh-token
VITE_EP_AUTH_ME=/auth/me

# 2. User & Profile Endpoints
VITE_EP_USERS=/users
VITE_EP_STUDENT_PROFILE=/users/profile/student
VITE_EP_TEACHER_PROFILE=/users/profile/teacher
VITE_EP_CHANGE_PASSWORD=/users/change-password
VITE_EP_FORGOT_PASSWORD=/users/forgot-password
VITE_EP_RESET_PASSWORD_CODE=/users/reset-password-code
VITE_EP_AVATAR=/users/avatar

# 3. Courses & Classes Endpoints
VITE_EP_COURSES=/courses
VITE_EP_COURSES_PUBLIC=/courses/public
VITE_EP_CLASSES=/classes
VITE_EP_CLASSES_PUBLIC=/classes/public
VITE_EP_MY_TAUGHT_CLASSES=/classes/my-taught-classes

# 4. Registrations & Enrollments Endpoints
VITE_EP_COURSE_REGISTRATIONS=/course-registrations
VITE_EP_ENROLLMENTS=/enrollments
VITE_EP_MY_ENROLLMENTS=/enrollments/my-enrollments
VITE_EP_REGISTER_CLASS=/enrollments/register
VITE_EP_CASH_PAYMENTS=/enrollments/payments/cash

# 5. Attendance & Schedule & Grades & Lessons Endpoints
VITE_EP_ATTENDANCE=/attendance
VITE_EP_MY_ATTENDANCE=/attendance/my-attendance
VITE_EP_ATTENDANCE_BATCH=/attendance/batch
VITE_EP_SCHEDULES=/schedules
VITE_EP_STUDENT_SCHEDULE=/schedules/my-schedule/student
VITE_EP_TEACHER_SCHEDULE=/schedules/my-schedule/teacher
VITE_EP_GRADES=/grades
VITE_EP_MY_GRADES=/grades/my-grades
VITE_EP_LESSONS=/lessons

# 6. Reviews Endpoints
VITE_EP_REVIEWS_CLASS=/reviews/class
VITE_EP_REVIEWS=/reviews

# 7. Dashboard Endpoints
VITE_EP_DASHBOARD=/dashboard

# 8. Rooms & Vouchers Endpoints
VITE_EP_ROOMS=/rooms
VITE_EP_VOUCHERS=/vouchers

# 9. Waitlist Endpoints
VITE_EP_WAITLIST=/waitlist

# 10. Certificates Endpoints
VITE_EP_CERTIFICATES=/certificates

# 11. Payroll Endpoints
VITE_EP_PAYROLL=/payroll

# 12. Exams Endpoints
VITE_EP_EXAMS=/exams

# 13. Audit Log Endpoints
VITE_EP_AUDIT_LOGS=/audit-logs
