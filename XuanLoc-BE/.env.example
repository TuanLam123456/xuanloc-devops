# Chuỗi kết nối MySQL: mysql://<user>:<password>@<host>:3306/<database>
# Chạy local: host=localhost | Chạy bằng docker compose: host=tên service MySQL (vd: mysql)
DATABASE_URL="mysql://root:your_password@localhost:3306/xuan_loc_center"

# Môi trường chạy: development | production (production bật cookie secure, bắt buộc HTTPS)
NODE_ENV=development

# Cổng chạy server (mặc định 3069 nếu không đặt)
PORT=3069

# Địa chỉ public của API, dùng để trả về link đầy đủ của ảnh avatar (production: https://api-xuanloc.bui-van-tuan-lam.com)
APP_URL=http://localhost:3069

# Số proxy đứng trước server: 0 = chạy local, 1 = sau nginx, 2 = sau Cloudflare + nginx
TRUST_PROXY=0

# Danh sách origin frontend được phép gọi API, phân tách bởi dấu phẩy
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Khoá bí mật để ký access token (ngắn hạn - 1 giờ) - chuỗi ngẫu nhiên, tạo bằng: openssl rand -hex 32
JWT_SECRET=change-me

# Khoá bí mật để ký refresh token (dài hạn - 7 ngày) - chuỗi ngẫu nhiên, khác JWT_SECRET
JWT_REFRESH_SECRET=change-me-too

# Cấu hình Email gửi OTP (Dùng cho nodemailer, Gmail cần App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Tài khoản nhận chuyển khoản học phí (dùng để sinh mã VietQR)
BANK_BIN=970422
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_DISPLAY_NAME=MB Bank
